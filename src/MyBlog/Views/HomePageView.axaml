<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyBlog.ViewModels"
             mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="900"
             x:Class="MyBlog.Views.HomePageView"
             x:DataType="vm:HomePageViewModel">
    <StackPanel MaxWidth="920" HorizontalAlignment="Left" Margin="32,28,32,0">

        <!-- Hero -->
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center" MaxWidth="560">
                <TextBlock Text="{Binding Greeting}" FontSize="13" Margin="0,0,0,10"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding SiteName}" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Tagline}" FontSize="15" Margin="0,8,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding Bio}" FontSize="13.5" TextWrapping="Wrap" LineHeight="23"
                           Margin="0,14,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <Border Grid.Column="1" Width="150" Height="150" CornerRadius="75" Margin="32,0,0,0"
                    Background="{StaticResource AvatarBrush}">
                <TextBlock Text="Z" FontSize="56" FontWeight="Bold" Foreground="#FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- 最新文章（第一条是《Hello World》）-->
        <StackPanel Tag="home-latest" Margin="0,44,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="sectionHeading" Text="最新文章"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                           Text="{Binding ArticleCount, StringFormat='共 {0} 篇'}"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Latest}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <!-- 关于本站 -->
        <StackPanel Tag="home-about" Margin="0,32,0,0">
            <TextBlock Classes="sectionHeading" Text="关于本站"/>
            <ItemsControl ItemsSource="{Binding Sections}"/>
        </StackPanel>

        <!-- 页脚 -->
        <Border Margin="0,24,0,0" Padding="0,16,0,20"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Footer}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        </Border>
    </StackPanel>
</UserControl>
