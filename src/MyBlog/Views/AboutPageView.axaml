<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyBlog.ViewModels"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="900"
             x:Class="MyBlog.Views.AboutPageView"
             x:DataType="vm:AboutPageViewModel">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="32,28,32,0">

        <TextBlock Classes="pageTitle" Text="关于"/>
        <TextBlock Classes="pageSubtitle"
                   Text="这个站是谁写的、怎么搭起来的，以及更新记录。左侧目录就是下面这两组小节。"/>

        <!-- 关于作者 -->
        <StackPanel Tag="about-author" Margin="0,30,0,0">
            <TextBlock Classes="groupHeading" Text="关于作者"/>
            <ItemsControl ItemsSource="{Binding AuthorSections}"/>
        </StackPanel>

        <!-- 关于本站 -->
        <StackPanel Tag="about-site" Margin="0,10,0,0">
            <TextBlock Classes="groupHeading" Text="关于本站"/>
            <ItemsControl ItemsSource="{Binding SiteSections}"/>
        </StackPanel>

        <Border Margin="0,4,0,0" Padding="0,16,0,20"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Footer}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        </Border>
    </StackPanel>
</UserControl>
