<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyBlog.ViewModels"
             mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="900"
             x:Class="MyBlog.Views.ArchivePageView"
             x:DataType="vm:ArchivePageViewModel">
    <StackPanel MaxWidth="920" HorizontalAlignment="Left" Margin="32,28,32,0">

        <TextBlock Classes="pageTitle" Text="文章"/>
        <TextBlock Classes="pageSubtitle" Text="按年份归档。点开卡片读全文，标着「待补充」的是还没写完的。"/>

        <!-- 年份分组：锚点由 CardGroupViewModel.Anchor 提供 -->
        <ItemsControl ItemsSource="{Binding Years}" Margin="0,28,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CardGroupViewModel">
                    <StackPanel Tag="{Binding Anchor}" Margin="0,0,0,12">
                        <TextBlock Classes="sectionHeading" Text="{Binding Title}"/>
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 归档说明 -->
        <Border Tag="archive-note" Classes="panel" Margin="0,20,0,0" MaxWidth="620"
                HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock Text="归档说明" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="文章按发布时间倒序、以年份分组；左侧目录的第一级是年份，第二级是这一年的每一篇。新文章会直接补进对应的年份里。"/>
            </StackPanel>
        </Border>

        <Border Margin="0,24,0,0" Padding="0,16,0,20"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Footer}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        </Border>
    </StackPanel>
</UserControl>
