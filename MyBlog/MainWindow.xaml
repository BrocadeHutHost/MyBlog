<Window x:Class="MyBlog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyBlog"
        mc:Ignorable="d"
        Title="MainWindow" SizeToContent="WidthAndHeight">
    <Grid>
        <StackPanel Width="600" Height="200">
            <Image Width="600" Height="200" ToolTip="这里我想可以更换或者轮换图片">

            </Image>
            <StackPanel Width="600" Height="1000" Orientation="Vertical">
                <TextBlock Text= "个人简介(我希望和最近在做并列而不是竖向排布) 头像名称经历之类的" Height="400" Width="300">
                </TextBlock>
                <TextBlock Text= "最近在做" Height="400" Width="300"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="最近项目与博客" ToolTip="可以上传一些文件包括我自己的项目，然后可以编辑博客（Markdown转换）">
                    
                </TextBlock>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="日程表" ToolTip="这里我想要可以编辑的日程表以及日程表设定有效期，过期清除显示还没有设置日程，可能忘记了之类的">
                    
                </TextBlock>
                <TextBlock Text="最后编辑日期：">
                    
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
